# Single source of truth for the pinned build toolchain of the Agentic Apps native build.
# Plain KEY=VALUE so bash (`set -a; . packaging/toolchain.env`), PowerShell and Python can all read it.
# Nothing here is "latest": every value is an exact version. Change a value only together with the
# lock files (packaging/regen-python-locks.sh, packaging/regen-cargo-lock.sh) and re-run
# packaging/verify-pins.py.

# --- Python ---------------------------------------------------------------------------------
# The frozen v0.3.2 build ran CPython 3.12.10 from the runner image's preinstalled interpreter
# (macos-14: the python.org framework at /usr/local/bin/python3.12; windows: C:\hostedtoolcache\...\3.12.10;
# NOT actions/setup-python, NOT uv's python-build-standalone). Locally (R0-prime check builds on a
# developer Mac) uv's python-build-standalone 3.12.10 is used. Same version, different build of
# CPython: the build manifest records which one produced an artifact.
PYTHON_VERSION=3.12.10

# --- Python build tools (hash-locked in packaging/locks/*) -----------------------------------
PYINSTALLER_VERSION=6.22.3
PYINSTALLER_HOOKS_CONTRIB_VERSION=2026.7
SETUPTOOLS_VERSION=84.0.0
PIP_VERSION=26.2.1
UV_VERSION=0.12.16

# Date up to which `uv pip compile --exclude-newer` resolves. 2026-09-18T14:00Z is just after the
# frozen CI run 35353188692 resolved its dependencies; with this cut-off the resolver reproduces the
# 21 third-party wheels of that run exactly (see packaging/PINS.md).
LOCK_EXCLUDE_NEWER=2026-09-18T14:00:00Z

# --- Rust / Tauri ----------------------------------------------------------------------------
RUST_VERSION=1.98.1
TAURI_CLI_VERSION=2.11.4

# --- Node ------------------------------------------------------------------------------------
# No Node step exists in this build: the Projects UI is vendored in agentic_os/projects_ui and the
# launcher page deploy/launcher/ui/index.html is a static file. Node is therefore NOT a build input.
NODE_VERSION=none

# --- CI runner images (GitHub-hosted; the image VERSION still floats, see build manifest) ---------
RUNNER_IMAGE_MACOS=macos-14
RUNNER_IMAGE_WINDOWS=windows-2022
RUNNER_IMAGE_LINUX=ubuntu-24.04
