# Self-hosted ReDevOps Projects — the Projects UI + API on one origin.
#   docker build -f Dockerfile.projects -t redevops-projects .
#   docker run -p 8787:8787 redevops-projects          # → http://localhost:8787
# The prebuilt UI (pinned redevops-projects release, packaging/projects_ui.lock.json) is fetched and
# sha256-verified by the wheel build hook, so no Node build is needed here (the build needs network access).
FROM python:3.12-slim
WORKDIR /app
# git is required at install time: runtime-contracts + redevops-connectors are git dependencies.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY . /app
# the mcp extra: the agent gateway serves a real MCP server (AGENT_GATEWAY_MCP=1), which stops startup without it
RUN pip install --no-cache-dir '.[projects,mcp]'
# A shipped image is a packaged deployment: it refuses to start until AGENTIC_OS_PROFILE is set explicitly (agentic_os/mission/profile.py).
ENV AGENTIC_OS_PACKAGED=1
ENV PROJECTS_HOST=0.0.0.0 PROJECTS_PORT=8787
EXPOSE 8787
CMD ["agentic-os-projects"]
