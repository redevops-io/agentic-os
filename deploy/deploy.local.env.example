# Copy to deploy/deploy.local.env (gitignored) and replace every REPLACE_ME. The deploy scripts refuse to run while one is left.
# Addresses and directories of YOUR target host belong here, never in a committed file (docs/DEPLOYMENT_ADDRESSES.md).

# Where to deploy: an SSH-reachable address of the target host (root access is assumed by the scripts).
AD_HOST=REPLACE_ME        # admin console
AT_HOST=REPLACE_ME        # attention console
EV_HOST=REPLACE_ME        # evidence explorer
PERM_HOST=REPLACE_ME      # permissions showcase
RC_HOST=REPLACE_ME        # reference billing core
SEC_HOST=REPLACE_ME       # security showcase
U_HOST=REPLACE_ME         # unsubscribe service
WC_HOST=REPLACE_ME        # world canvas

# A checkout of the runtime-contracts package (staged into the build context by most scripts).
RUNTIME_CONTRACTS=REPLACE_ME

# Optional: directories on the target (defaults are under /opt/agentic-os/), for example
# AD_HOST_DIR=/srv/agentic-os/admin-console
# U_DATA_DIR=/srv/agentic-os/unsubscribe-data     # where the unsubscribe ledger persists on the target
