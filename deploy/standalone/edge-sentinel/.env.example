# Names only: copy to .env and set. No secret belongs in this file; the three secrets live in ./secrets/ (created by bootstrap.sh).
COMPOSE_PROJECT_NAME=edge-sentinel
EDGE_SENTINEL_IMAGE=ghcr.io/redevops-io/edge-sentinel:0.6.3
EDGE_SENTINEL_BIND=127.0.0.1
EDGE_SENTINEL_PORT=8203
SENTINEL_BASIC_AUTH_USER=operator
SENTINEL_BLOCK_ENABLED=
SENTINEL_PROTECTED_IPS=
SENTINEL_BLOCK_ALLOW_NETWORKS=
EDGE_SENTINEL_DEMO=
CROWDSEC_DISABLE_ONLINE_API=true
CROWDSEC_COLLECTIONS=
