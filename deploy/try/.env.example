# Try ReDevOps — your LLM setup. Copy to `.env` and fill ONE of the two options.
# (Both hosted and locally-deployed models are supported.)

# ── Option A · Hosted / cloud (bring your API key) ────────────────────────────────────
# Any OpenAI-compatible endpoint. Leave LLM_MODEL blank to auto-discover.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Examples:
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   Anthropic  LLM_BASE_URL=https://api.anthropic.com/v1     LLM_MODEL=claude-sonnet-5
#   Together   LLM_BASE_URL=https://api.together.xyz/v1
#   (set LLM_API_KEY to that provider's key)

# ── Option B · Local / self-hosted model (no key) ─────────────────────────────────────
# Point at a model running on YOUR machine; leave LLM_API_KEY empty. From inside the
# container the host is reachable as host.docker.internal.
#   Ollama     LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=llama3.1
#   vLLM       LLM_BASE_URL=http://host.docker.internal:8000/v1
#   LM Studio  LLM_BASE_URL=http://host.docker.internal:1234/v1
