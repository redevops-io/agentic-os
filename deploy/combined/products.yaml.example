# The product registry Projects loads through AGENTIC_OS_PRODUCTS (copied to products.yaml by bootstrap.sh).
# Service names are the compose service names on the shared network; ui_url values are the HOST origins —
# adapters append their own /ui/... paths, so never put a path here. Secret paths are container paths.
schema: aos.products/v1
allow_private_http: [edge-sentinel, redevops-qa]   # the two product service names on the private compose network
products:
  - id: edge-sentinel
    display_name: Edge Sentinel
    kind: security
    api_base: http://edge-sentinel:8203
    ui_url: http://127.0.0.1:8203                   # must match EDGE_SENTINEL_PORT in .env
    health: {path: /readyz, interval_s: 5, timeout_s: 3}
    contract: {api: /api/v1, info: /api/v1/info, min_version: "1"}
    auth:
      scheme: control_token
      service_token_file: /run/products/edge-sentinel.service_token
      approval_secret_file: /run/products/approval_secret

  - id: redevops-qa                                  # the quality gate for this kind is open (docs/products/gates.py)
    display_name: redevops-qa
    kind: quality
    api_base: http://redevops-qa:8080
    ui_url: http://127.0.0.1:8080                    # must match QA_PORT in .env; the browser opens /ui/ at this origin
    health: {path: /readyz, interval_s: 5, timeout_s: 3}
    contract: {api: /v1, info: /v1/info, min_version: "1"}
    auth:
      scheme: bearer
      service_token_file: /run/products/redevops-qa.service_token
      approval_secret_file: /run/products/approval_secret