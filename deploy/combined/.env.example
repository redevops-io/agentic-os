# Combined install — copy to .env (bootstrap.sh does it once) and edit. No secret is kept here except the two
# service tokens bootstrap.sh generates; every other credential lives in ./secrets/ files.

# --- versions (pin what you verified; these were live-verified together on 2026-11-14).
# The Edge Sentinel image and port are configured in ../standalone/edge-sentinel/.env (one owner, no dual truth).
QA_IMAGE=ghcr.io/redevops-io/redevops-qa
QA_IMAGE_TAG=0.6.5
PROJECTS_IMAGE=rails-projects:combined

# --- host ports (all published on loopback only; ui_url in products.yaml must match these) ------------------
PROJECTS_BIND=127.0.0.1
PROJECTS_PORT=8787
QA_BIND=127.0.0.1
QA_PORT=8080

# --- the Sentinel stack (../standalone/edge-sentinel) -------------------------------------------------------
# its compose project name decides the shared network name; do not run two combined installs with the same name
SENTINEL_PROJECT=edge-sentinel
SENTINEL_NETWORK=edge-sentinel_sentinel

# --- identity seeded by bootstrap.sh ------------------------------------------------------------------------
# the browser sign-in for Projects (the file secrets/operator_basic holds "user:password")
OPERATOR_USER=operator
# the named Sentinel user Projects acts as (the external actor "projects:<OPERATOR_USER>" is linked to it)
SENTINEL_NAMED_USER=alex

# --- tokens generated once by bootstrap.sh (do not paste real values into the repository) -------------------
QA_SERVICE_TOKEN=
QA_APPROVAL_SECRET=
QA_BOOTSTRAP_ADMIN_PASSWORD=
QA_RUN_TIMEOUT=1800