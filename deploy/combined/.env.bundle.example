# The single-pull bundle (compose.bundle.yml / `ghcr.io/redevops-io/redevops-ts`) — copy to .env.bundle (bundle-
# bootstrap.sh does it once) and edit. Every value here is a plain environment variable: the bundle has no
# file-based secret or config, by design (see compose.bundle.yml's header comment for why).

# --- versions ---------------------------------------------------------------------------------------------
QA_IMAGE_TAG=0.6.6
EDGE_SENTINEL_IMAGE_TAG=0.6.7
PROJECTS_IMAGE_TAG=bundle-0.1.12
BUNDLE_TAG=0.1.12

# QA_PLATFORM: leave unset (the host's own architecture). bundle-bootstrap.sh sets it only for bundles up to 0.1.8 on an arm64 host without amd64 emulation.

# --- host ports (all published on loopback only) ----------------------------------------------------------
PROJECTS_BIND=127.0.0.1
PROJECTS_PORT=8787
QA_BIND=127.0.0.1
QA_PORT=8080
EDGE_SENTINEL_BIND=127.0.0.1
EDGE_SENTINEL_PORT=8203

# --- identity ----------------------------------------------------------------------------------------------
OPERATOR_USER=operator
SENTINEL_NAMED_USER=alex

# --- generated once by bundle-bootstrap.sh (do not paste real values into the repository) ------------------
OPERATOR_BASIC_AUTH=
SENTINEL_BASIC_AUTH_PASS=
CROWDSEC_BOUNCER_KEY=
CROWDSEC_MACHINE_PASSWORD=
EDGE_SENTINEL_SERVICE_TOKEN=
QA_SERVICE_TOKEN=
QA_BOOTSTRAP_ADMIN_PASSWORD=
APPROVAL_SECRET=
