# Projects + Sidekick orchestration node — configuration. Copy to .env and edit.
# Nothing here is required to START (it boots in demo mode); set the model to do real work.

# ── The one real dependency: a model endpoint ──────────────────────────────────────────
# Local (≈free, default): run ollama/llama.cpp on the host, expose an OpenAI-compatible /v1.
REDEVOPS_LLM_BASE_URL=http://host.docker.internal:11434/v1
REDEVOPS_LLM_MODEL=qwen3.5
# …or a cloud endpoint instead:
# REDEVOPS_LLM_BASE_URL=https://api.openai.com/v1
# REDEVOPS_LLM_MODEL=gpt-5

# Optional cloud keys — enable multi-vendor agent dispatch (Claude + GPT in parallel). Blank = fully local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional: 3rd-party agents + channels (bring only what you use) ─────────────────────
# External agents arrive over MCP/A2A at runtime — no static config needed to accept them.
# Channel credentials (for triggers / delivery / approvals):
SLACK_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# MSTEAMS / GOOGLE_CHAT tokens as needed.

# ── Host ──
HTTP_PORT=8290
IMAGE_TAG=stable
