# Sidekick for DevOps — copy to .env and edit.

# Your OpenAI-compatible model endpoint (self-hosted llama.cpp/vLLM, or a hosted API).
# Used for narration + the stack/cost advisors; the governed missions run without it.
MODEL_ENDPOINT=http://host.docker.internal:8000/v1

# Path on YOUR machine to the kubeconfig Sidekick should inspect (mounted READ-ONLY).
KUBECONFIG_HOST=~/.kube/config

# Which namespace to inspect by default.
INSPECT_NAMESPACE=default

# Grafana admin password (anonymous Viewer access is on by default).
GRAFANA_ADMIN_PASSWORD=admin

# Set to 0 to disable the standing monitor loop.
MONITOR_ENABLED=1

# Federated operators (optional): path to a modules.yaml mapping operator name → base URL. When set,
# Sidekick discovers those external /invoke services and governs them as first-class capabilities
# (see modules.example.yaml). Unset → the built-in in-process infra + sky operators.
SIDEKICK_MODULES=

# Per-operator invoke timeout (seconds) for the federated HTTP path.
OPERATOR_TIMEOUT=60

# Stakeholder alerting (opt-in): a webhook (Slack-compatible or any JSON endpoint) that gets a
# message when a governed response mission holds for sign-off, and when a mission finishes.
ALERT_WEBHOOK_URL=
