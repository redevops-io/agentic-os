# Slim uniform stand-in image for any redevops.io module in the demo.
# Build context is the repo root: docker build -f deploy/Dockerfile.module .
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.29"
COPY deploy/module_service.py ./module_service.py
ENV PORT=8000
# Bind to $PORT at runtime (sh -c so the env var expands).
CMD ["sh", "-c", "uvicorn module_service:app --host 0.0.0.0 --port ${PORT}"]
