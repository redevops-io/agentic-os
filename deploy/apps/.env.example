# ReDevOps Business Apps — deployment configuration.
# Copy to `.env` and edit. `docker compose` reads `.env` automatically.
# Everything with a default can be left as-is for a local trial; the marked
# secrets MUST be set or the stack will refuse to start.

# --- Registry + version -----------------------------------------------------
# The app images (6 domain agents + console) are public on GHCR — no login needed.
REGISTRY=ghcr.io/redevops-io
APPS_TAG=stable

# --- Front door -------------------------------------------------------------
HTTP_PORT=8080                       # open http://<host>:8080 for the console

# --- Tenant + safety --------------------------------------------------------
TENANT=Summit Roofing Co.
SHADOW_MODE=true                     # true = agents stage actions for human approval (recommended)

# --- LLM endpoint (OpenAI-compatible) ---------------------------------------
# Point at any OpenAI-compatible /v1 endpoint (your own vLLM/Ollama, or a hosted
# provider). host.docker.internal reaches a model server on the Docker host.
REDEVOPS_LLM_BASE_URL=http://host.docker.internal:8000/v1
REDEVOPS_LLM_MODEL=qwen3.8-27b
OPENAI_API_KEY=EMPTY

# --- Twenty CRM -------------------------------------------------------------
TWENTY_PORT=3010
TWENTY_SERVER_URL=http://localhost:3010
# REQUIRED: >= 32 bytes. Generate: openssl rand -base64 32
TWENTY_APP_SECRET=
TWENTY_DB_PASSWORD=twenty
# After first boot, create a Twenty API key in the UI and paste it here, then
# `docker compose up -d revenue-agent` to reconnect the revenue agent.
TWENTY_API_KEY=

# --- Metabase ---------------------------------------------------------------
METABASE_PORT=3001
METABASE_DB_PASSWORD=metabase

# --- Postiz -----------------------------------------------------------------
POSTIZ_PORT=4200
POSTIZ_MAIN_URL=http://localhost:4200
# REQUIRED: generate: openssl rand -base64 32
POSTIZ_JWT_SECRET=
POSTIZ_DB_PASSWORD=postiz

# --- Optional -------------------------------------------------------------
# GITHUB_TOKEN=            # lets the revenue agent enrich accounts from GitHub
