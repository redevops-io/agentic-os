{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReDevOps Launcher",
  "version": "0.1.0",
  "identifier": "io.redevops.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "ReDevOps",
        "width": 560,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": ["icons/icon.png"]
  }
}
