{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Apps",
  "version": "0.2.0",
  "identifier": "io.redevops.agentic-apps",
  "mainBinaryName": "agentic-apps",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Agentic Apps",
        "width": 560,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Governed AI control plane — your apps as one system",
    "longDescription": "ReDevOps runs your business apps as one governed agentic system: connect apps, run missions across them, approve the consequential steps. One suite installer, native, bring your own model (hosted or local). No Docker required.",
    "externalBin": ["binaries/redevops-sidecar"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
